# Application
APP_NAME=TickVendor
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CANONICAL_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./tickvendor.db
DATABASE_ECHO=false

# Frontend/CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Infrastructure/build variable consumed by the Vite frontend.
VITE_API_ORIGIN=http://localhost:8000

# Core security
SECRET_KEY=change-me-in-staging-and-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Paystack V1; webhook HMAC uses PAYSTACK_SECRET_KEY by default.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
# Optional internal override only; Paystack does not issue a distinct webhook secret.
PAYSTACK_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Generic HTTP push gateway
PUSH_PROVIDER=memory
PUSH_ENDPOINT=
PUSH_API_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379/0
DISTRIBUTED_RATE_LIMIT_ENABLED=false

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Monitoring
METRICS_ENDPOINT=
MONITORING_API_TOKEN=

# Worker (deployment/script configuration; consumed by scripts/notification_worker.py)
NOTIFICATION_WORKER_BATCH_SIZE=100
