# Application
APP_NAME=TickVendor
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CANONICAL_URL=https://tickvendor.com
DATABASE_URL=sqlite:///./tickvendor.db
# Production example: postgresql+psycopg://user:password@host/tickvendor
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://tickvendor.com,https://www.tickvendor.com

# Replace with a cryptographically random value outside development.
SECRET_KEY=change-me-in-staging-and-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# V1 payment provider: Paystack. Stripe and Flutterwave are optional/future.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Distributed rate limiting (enable only with a shared Redis-compatible store)
REDIS_URL=redis://localhost:6379/0
DISTRIBUTED_RATE_LIMIT_ENABLED=false
