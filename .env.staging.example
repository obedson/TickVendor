# TickVendor staging template; store populated values in platform secrets, never Git.

# CORE
APP_NAME=TickVendor
ENVIRONMENT=staging
DEBUG=false
API_V1_PREFIX=/api/v1
CANONICAL_URL=https://<staging-frontend-host>
FRONTEND_URL=https://<staging-frontend-host>
LOG_LEVEL=INFO
SECRET_KEY=<generate-at-least-32-random-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# DATABASE
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_ECHO=false

# FRONTEND/CORS
CORS_ORIGINS=https://<staging-frontend-host>
# Infrastructure/build variable consumed by Vite, not backend settings.
VITE_API_ORIGIN=https://<staging-api-host>

# PAYSTACK
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=<paystack-test-secret-key>
# Optional internal HMAC override only. Omit to use PAYSTACK_SECRET_KEY per Paystack's contract.
PAYSTACK_WEBHOOK_SECRET=

# EMAIL
EMAIL_PROVIDER=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password-or-app-password>
SMTP_FROM_ADDRESS=<verified-sender-address>

# PUSH — generic HTTP gateway contract
PUSH_PROVIDER=http
PUSH_ENDPOINT=https://<push-gateway>/send
PUSH_API_TOKEN=<push-gateway-token>

# REDIS
REDIS_URL=rediss://:<password>@<host>:6380/0
DISTRIBUTED_RATE_LIMIT_ENABLED=true

# STORAGE — private S3-compatible bucket
STORAGE_PROVIDER=s3
STORAGE_BUCKET=<private-staging-bucket>
STORAGE_REGION=<region>
STORAGE_ENDPOINT=<optional-s3-compatible-endpoint>
STORAGE_ACCESS_KEY=<access-key>
STORAGE_SECRET_KEY=<secret-key>
STORAGE_SIGNED_URL_TTL_SECONDS=900

# MONITORING — vendor-neutral structured event HTTP collector
METRICS_ENDPOINT=https://<monitoring-collector>/events
MONITORING_API_TOKEN=<collector-token>

# WORKER — consumed by scripts/notification_worker.py
NOTIFICATION_WORKER_BATCH_SIZE=100

# DEPLOYMENT (platform configuration, not application settings)
PORT=8000
