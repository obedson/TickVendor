# TickVendor staging environment template
# Copy into the staging platform secret/configuration store; do not commit a populated copy.

# Core application
APP_NAME=TickVendor
ENVIRONMENT=staging
DEBUG=false
API_V1_PREFIX=/api/v1
CANONICAL_URL=https://staging.tickvendor.com
LOG_LEVEL=INFO
SECRET_KEY=<generate-at-least-32-random-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# PostgreSQL
DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@<db-host>:5432/<db-name>?sslmode=require

# Paystack sandbox
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=<paystack-test-secret-key>
PAYSTACK_WEBHOOK_SECRET=<paystack-webhook-signing-secret-or-same-secret-key>

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password-or-app-password>
SMTP_FROM_ADDRESS=<verified-sender-address>

# Push gateway
PUSH_PROVIDER=http
PUSH_ENDPOINT=https://<push-gateway>/send
PUSH_API_TOKEN=<push-gateway-token>

# Shared rate limiting
REDIS_URL=rediss://:<redis-password>@<redis-host>:6380/0
DISTRIBUTED_RATE_LIMIT_ENABLED=true

# Object storage (not consumed by the current filesystem upload implementation)
# Configure only after the storage abstraction is implemented.
STORAGE_PROVIDER=<s3-compatible-provider>
STORAGE_ENDPOINT=<s3-endpoint>
STORAGE_REGION=<region>
STORAGE_BUCKET=<staging-bucket>
STORAGE_ACCESS_KEY=<access-key>
STORAGE_SECRET_KEY=<secret-key>

# Frontend/API and CORS
FRONTEND_URL=https://staging.tickvendor.com
API_URL=https://api-staging.tickvendor.com
CORS_ORIGINS=https://staging.tickvendor.com

# Monitoring
ERROR_TRACKING_DSN=<error-tracking-dsn>
METRICS_ENDPOINT=<metrics-endpoint>
ALERT_WEBHOOK_URL=<alert-webhook-url>

# Worker
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_BATCH_SIZE=100
